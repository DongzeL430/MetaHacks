# Copy to .env and fill in. Never commit .env.
# Supabase values: Dashboard > Project Settings > API Keys, or
#   npx supabase@2.122.0 projects api-keys --project-ref <project-ref> --reveal

# Safe in the browser. Vite only exposes VITE_ variables to the app, and reads this file
# because StudBuds/vite.config.ts sets envDir: '..'. Row level security limits what the
# publishable key can do.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=

# Server only. Never prefix these with VITE_, or they ship to every visitor's browser.
SUPABASE_SECRET_KEY=
META_API_KEY=
TURNSTILE_SECRET=

# The Gmail account that sends sign-up and password emails, and its app password.
SMTP_USER=
SMTP_PASS=
