# Copy to .env (never commit .env). The app reads the VITE_ keys; they're public browser keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
# Optional: the view-only demo login behind "Try the demo" (printed by scripts/demo-account.mjs)
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Server-side only: Supabase secrets, Edge Function secrets and local test scripts. Never in the browser.
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET=
SMTP_USER=
SMTP_PASS=
META_API_KEY=
