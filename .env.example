# Copy to .env and fill in. Never commit .env.
# Supabase values: Dashboard > Project Settings > API Keys, or
#   npx supabase@2.122.0 projects api-keys --project-ref <project-ref>

# Safe to expose to the browser. Row level security decides what it can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row level security, so it must never reach client code.
SUPABASE_SECRET_KEY=

# Server only. Meta Model API, for the agents.
META_API_KEY=

# Added when the sign-up page exists (see docs/auth-setup.md).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
